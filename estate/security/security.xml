<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="base.module_category_real_estate_brokerage" model="ir.module.category">
        <field name="description">Real Estate Management</field>
        <field name="sequence">10</field>
    </record>

    <record id="estate_group_agent" model="res.groups">
        <field name="name">Agent</field>
        <field name="category_id" ref="base.module_category_real_estate_brokerage"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="estate_group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="base.module_category_real_estate_brokerage"/>
        <field name="implied_ids" eval="[(4, ref('estate.estate_group_agent'))]"/>
    </record>

    <record id="rule_property_agent" model="ir.rule">
        <field name="name">Agents can read/write if no salesperson or it's them of the current company</field>
        <field name="model_id" ref="estate.model_estate_property"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[Command.link(ref('estate.estate_group_agent'))]"/>
        <field name="domain_force">[
            '&amp;',
            '|', ('seller_id', '=', False), ('seller_id.id', '=', user.id),
            ('company_id', 'in', company_ids + [False])]
        </field>
    </record>

    <record id="rule_property_manager" model="ir.rule">
        <field name="name">Full access property if manager</field>
        <field name="model_id" ref="estate.model_estate_property"/>
        <field name="groups" eval="[Command.link(ref('estate.estate_group_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
